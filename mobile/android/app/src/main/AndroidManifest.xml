<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Solo mentre Termux scarica il pacchetto dall'app (vedi ServizioPacchetto). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Notifiche dei messaggi con l'app chiusa, senza Google (ServizioNotifiche): il permesso
         di mostrarle (Android 13+) e il tipo «messaggistica» del servizio (Android 14+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <!-- Per chiedere a Termux di avviare Nyctalus (intent RUN_COMMAND).
         Va abbinato a "allow-external-apps = true" in ~/.termux/termux.properties,
         riga che l'installatore di Nyctalus aggiunge da solo. -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 11+: rende visibili Termux e le app fotocamera/selettore file. -->
    <queries>
        <package android:name="com.termux" />
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <intent><action android:name="android.media.action.VIDEO_CAPTURE" /></intent>
        <intent><action android:name="android.intent.action.GET_CONTENT" /><data android:mimeType="*/*" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- «Collega l'app»: nyctalus://rete?codice=NYCT1:… dalla pagina della rete di
                 casa (o da un messaggio). L'app chiede SEMPRE conferma con nome e impronta. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nyctalus" android:host="rete" />
            </intent-filter>
        </activity>

        <!-- Il browser (derivato da NovaOS) in un PROCESSO SEPARATO: il proxy della WebView
             vale per processo, così la modalità Nyctalus non tocca la chat. -->
        <activity
            android:name=".BrowserActivity"
            android:process=":browser"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <service
            android:name=".ServizioPacchetto"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ServizioNotifiche"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging|dataSync" />

        <!-- Foto scattate dalla chat: restano nella cartella PRIVATA dell'app (non nella
             galleria del telefono); la fotocamera ci scrive con un permesso temporaneo. -->
        <provider
            android:name=".FotoProvider"
            android:authorities="org.nyctalus.mobile.foto"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
