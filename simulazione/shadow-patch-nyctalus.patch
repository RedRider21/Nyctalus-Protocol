+    /// Patch Nyctalus: `recvmmsg` (usata da QUIC/quinn per ricevere più pacchetti insieme) come
+    /// UN solo `recvmsg` nel primo elemento del vettore. Stesso comportamento di blocco e degli
+    /// errori di `recvmsg`; restituisce 1 messaggio. A quinn basta, e i tempi simulati non cambiano.
+    pub fn recvmmsg(
+        ctx: &mut SyscallContext,
+        fd: std::ffi::c_int,
+        msgvec: ForeignPtr<libc::mmsghdr>,
+        vlen: std::ffi::c_uint,
+        flags: std::ffi::c_int,
+        _timeout: ForeignPtr<libc::timespec>,
+    ) -> Result<std::ffi::c_int, SyscallError> {
+        if vlen == 0 {
+            return Ok(0);
+        }
+        let n = Self::recvmsg(ctx, fd, msgvec.cast::<libc::msghdr>(), flags & !libc::MSG_WAITFORONE)?;
+        let posto = std::mem::offset_of!(libc::mmsghdr, msg_len);
+        let len_ptr = msgvec.cast::<u8>().add(posto).cast::<std::ffi::c_uint>();
+        ctx.objs.process.memory_borrow_mut().write(len_ptr, &(n as std::ffi::c_uint))?;
+        Ok(1)
+    }
