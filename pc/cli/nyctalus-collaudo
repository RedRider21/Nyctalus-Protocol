def controllo_configurazione(r, dove, cfg, motore):
    r.titolo("1 · Configurazione")
    if motore:
        r.ok("motore trovato", motore)
    else:
        r.ko("motore «nyctalus» non trovato", "installa Nyctalus o indica il programma con NYCTALUS_BIN=/percorso/nyctalus")
    url, aut = str(cfg.get("directory_url", "")), str(cfg.get("authority", ""))
    if url and re.fullmatch(r"[0-9a-f]{64}", aut):
        r.ok("rete configurata: %s" % (cfg.get("nome_rete") or cfg.get("nome") or "senza nome"),
             "%s · elenco dei nodi: %s" % (dove, url))
    else:
        r.ko("nessuna rete pubblica configurata in %s" % dove,
             "incolla il codice di rete (NYCT1:…) nelle Impostazioni, poi rilancia il collaudo")
        return False
    _op, forma = opzioni_protezione(cfg)
    (r.ok if _op else r.nota)("forma del traffico: %s" % forma,
                               "" if _op else "chi osserva la linea riconosce Nyctalus: valuta «nyctalus-rete protezione»")
    for k, cosa in (("rubrica", "rubrica della rete"), ("casella", "casella dei messaggi")):
        if re.fullmatch(r"[a-z2-7]{56}\.nyct", str(cfg.get(k, ""))):
            r.ok("%s configurata" % cosa)
        else:
            r.nota("%s non configurata" % cosa, "i messaggi a chi non è in linea non partono" if k == "casella" else "")
    return bool(motore)


def scarica_elenco(url, cartella):
    dest = Path(cartella) / "elenco.txt"
    if os.path.isfile(url):
        shutil.copy(url, dest)
    else:
        with urllib.request.urlopen(url, timeout=25) as risposta:
            dest.write_bytes(risposta.read(4 * 1024 * 1024))
    return dest


def sonda(motore, elenco, aut, opzioni, attesa=4):
    """`nyctalus nodes --probe` → (codice, raggiungibili, totale, [ms], uscita)."""
    try:
        p = subprocess.run([motore, "nodes", "--directory", str(elenco), "--authority", aut, "--probe",
                            "--timeout", str(attesa)] + opzioni, capture_output=True, text=True, timeout=180)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, 0, 0, [], str(e)
    m = re.search(r"(\d+)/(\d+) nodes reachable", p.stdout)
    tempi = [int(x) for x in re.findall(r"online\s+(\d+) ms", p.stdout)]
    return p.returncode, int(m.group(1)) if m else 0, int(m.group(2)) if m else 0, tempi, (p.stdout + p.stderr).strip()


def controllo_nodi(r, cfg, motore, cartella):
    r.titolo("2 · Nodi della rete")
    aut = cfg["authority"]
    try:
        elenco = scarica_elenco(cfg["directory_url"], cartella)
    except Exception as e:      # noqa: BLE001
        r.ko("l'elenco dei nodi non si scarica", str(e))
        return None
    op, _forma = opzioni_protezione(cfg)
    codice, vivi, totale, tempi, uscita = sonda(motore, elenco, aut, op)
    if codice != 0 or totale == 0:
        r.ko("elenco dei nodi non valido (firma dell'autorità o formato)", uscita.splitlines()[-1][:200] if uscita else "")
        return None
    r.ok("elenco firmato dall'autorità della rete: %d nodi" % totale)
    dett = "tempo di risposta: mediana %d ms, peggiore %d ms" % (statistics.median(tempi), max(tempi)) if tempi else ""
    r.nodi_spenti = re.findall(r"^\s*\d+\s+(\S+)\s+\S+\s+\S+\s+○", uscita, re.M)
    if vivi == totale:
        r.ok("tutti i %d nodi rispondono" % totale, dett)
    elif vivi >= 3:
        r.nota("%d nodi su %d rispondono (ne bastano 3 per un circuito)" % (vivi, totale),
               "spenti o irraggiungibili: " + ", ".join(r.nodi_spenti)[:200])
    else:
        r.ko("solo %d nodi su %d rispondono: servono almeno 3" % (vivi, totale),
             "controlla che i nodi siano accesi e le porte aperte (UDP e TCP) sul router/firewall")
    # sonde mute: chi NON ha la chiave della rete non deve ottenere risposta dai nodi
    if "--obfuscation" in op:
        if "--mimic" in op:
            r.saltata("sonde senza chiave", "forma HTTP/3: a chi sonda i nodi rispondono come un sito qualunque (è voluto)")
        else:
            _c, vivi_senza, tot, _t, _u = sonda(motore, elenco, aut, [], attesa=3)
            if vivi_senza == 0:
                r.ok("a chi non ha la chiave della rete i nodi non rispondono (%d su %d muti)" % (tot, tot))
            else:
                r.ko("%d nodi rispondono anche SENZA la chiave della rete" % vivi_senza,
                     "quei nodi girano senza --obfuscation: riavviali con la protezione della rete")
    else:
        r.saltata("sonde senza chiave", "la rete non ha camuffamento")
    return elenco if vivi >= 3 else None


def prepara_tunnel(r, cfg, motore, elenco, cartella, porta_abituale, scelta):
    """Usa il tunnel acceso; se non c'è ne accende uno temporaneo. → ((host, porta), processo)"""
    r.titolo("3 · Tunnel")
    if scelta:
        host, _, p = scelta.rpartition(":")
        socks = (host or "127.0.0.1", int(p))
        if porta_aperta(*socks):
            r.ok("uso il tunnel indicato: %s:%d" % socks)
            return socks, None
        r.ko("nessun tunnel in ascolto su %s:%d" % socks)
        return None, None
    if porta_aperta("127.0.0.1", porta_abituale):
        r.ok("tunnel già acceso (porta %d): uso quello" % porta_abituale)
        return ("127.0.0.1", porta_abituale), None
    if not elenco:
        r.ko("tunnel spento e nodi insufficienti per accenderne uno")
        return None, None
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        libera = s.getsockname()[1]
    op, _f = opzioni_protezione(cfg)
    ambiente = dict(os.environ)
    ponti = (cfg.get("ponti") or {}).get(cfg.get("authority", ""), [])
    if ponti:
        ambiente["NYCTALUS_PONTI"] = ";".join(ponti)
    # se l'entrata scelta a caso è un nodo spento il motore rinuncia: si riprova (altra entrata)
    coda = []
    for giro in range(1, 6):
        diario = open(Path(cartella) / "tunnel.log", "wb")
        proc = subprocess.Popen([motore, "start", "--directory", str(elenco), "--authority", cfg["authority"],
                                 "--socks", "127.0.0.1:%d" % libera] + op, stdout=diario, stderr=subprocess.STDOUT, env=ambiente)
        for _ in range(120):
            if porta_aperta("127.0.0.1", libera, 0.3):
                time.sleep(1.0)
                if proc.poll() is None:
                    if giro == 1:
                        r.ok("tunnel temporaneo acceso per il collaudo (porta %d)" % libera, "viene spento alla fine")
                    else:
                        r.nota("tunnel temporaneo acceso al tentativo n. %d (porta %d)" % (giro, libera),
                               "ai tentativi prima l'entrata scelta era un nodo spento: " + " · ".join(coda)[:160])
                    return ("127.0.0.1", libera), proc
            if proc.poll() is not None:
                break
            time.sleep(0.5)
        diario.close()
        coda = (Path(cartella) / "tunnel.log").read_text(errors="replace").strip().splitlines()[-2:]
        if proc.poll() is None:
            proc.kill()
            break
    # l'entrata fissa (guardia, ricordata in ~/.nyctalus/guardie come fa Tor) è un nodo spento?
    spenti = getattr(r, "nodi_spenti", [])
    guardia = next((n for n in spenti if any(n in riga for riga in coda)), None)
    if guardia:
        r.ko("il tunnel non parte: le tue ENTRATE FISSE (guardie primarie) sono spente, per esempio %s" % guardia,
             "il motore entra solo dalle sue 3 guardie primarie, sempre le stesse (come Tor, per l'anonimato): "
             "riaccendine almeno una; solo se sono spente per sempre cancella ~/.nyctalus/guardie e ne verranno scelte altre")
    else:
        r.ko("il tunnel non parte", " · ".join(coda)[:240])
    return None, None


def controllo_ip(r, socks, senza_diretto):
    r.titolo("4 · Indirizzo IP")
    dal_tunnel, errori = che_ip(socks)
    if not dal_tunnel:
        r.ko("dal tunnel non si raggiunge Internet", "; ".join(errori)[:240])
        return False
    r.ok("dal tunnel Internet si raggiunge: i siti vedono %s" % ", ".join(sorted(dal_tunnel)), "è l'indirizzo dell'uscita")
    if senza_diretto:
        r.saltata("confronto con il tuo indirizzo vero", "--senza-diretto")
        return True
    diretto, errori = che_ip(None)
    if not diretto:
        r.nota("non riesco a leggere il tuo indirizzo vero in diretta (confronto saltato)", "; ".join(errori)[:200])
    elif diretto & dal_tunnel:
        r.ko("i siti vedono il TUO indirizzo anche dal tunnel (%s)" % ", ".join(maschera(i) for i in diretto & dal_tunnel),
             "l'uscita della rete sta sulla tua stessa linea: per nascondere l'IP serve un'uscita su un'altra macchina/linea")
    else:
        r.ok("il tuo indirizzo vero (%s) NON è quello che vedono i siti" % ", ".join(maschera(i) for i in sorted(diretto)))
    return True


def controllo_dns(r, socks, cartella):
    r.titolo("5 · Nomi dei siti (DNS)")
    ascolto = AscoltoDns(cartella)
    if not ascolto.avvia():
        r.saltata("ascolto delle richieste DNS",
                  "serve dumpcap o tcpdump con il permesso di catturare (%s). Su Linux: «sudo setcap cap_net_raw,cap_net_admin+eip $(command -v dumpcap)» "
                  "o lancia il collaudo con sudo -E" % (ascolto.motivo or "non disponibile"))
        return
    host, percorso = SERVIZIO_SOLO_TUNNEL
    try:
        stato, _c, _p, _t = https(host, percorso, socks)
        riuscita = stato == 200
    except (OSError, ssl.SSLError):
        riuscita = False
    # controprova: una richiesta DNS vera, per essere sicuri che l'ascolto veda qualcosa
    spia = "collaudo-%d.example.com" % int(time.time())
    try:
        socket.getaddrinfo(spia, 80)
    except OSError:
        pass
    cattura = ascolto.ferma()
    if not riuscita:
        r.nota("la richiesta di prova dal tunnel non è riuscita: controllo DNS non conclusivo")
    elif not nome_nel_dns(cattura, spia):
        r.saltata("ascolto delle richieste DNS", "l'ascolto non vede il DNS di questo computer (resolver locale cifrato o cattura limitata)")
    elif nome_nel_dns(cattura, host):
        r.ko("il nome del sito visitato dal tunnel è uscito in una richiesta DNS di questo computer",
             "il programma risolve i nomi da sé: va configurato «DNS attraverso il proxy» (SOCKS5 con nomi remoti)")
    else:
        r.ok("nessuna richiesta DNS per il sito visitato dal tunnel: il nome lo risolve l'uscita",
             "vale per i programmi di Nyctalus e per chi usa il proxy con i nomi remoti (socks5h)")


def controllo_velocita(r, socks, megabyte):
    r.titolo("6 · Velocità")
    primi = []
    for _ in range(3):
        try:
            _s, _c, primo, _t = https(SERVIZI_IP[0][0], "/", socks)
            primi.append(primo)
        except (OSError, ssl.SSLError):
            pass
    if primi:
        mediana = statistics.median(primi)
        (r.ok if mediana < 4 else r.nota)("apertura di una pagina (primo byte): %.1f s" % mediana,
                                          "" if mediana < 4 else "lento: guarda i tempi dei nodi al punto 2")
    else:
        r.ko("nessuna pagina si apre dal tunnel")
        return
    quanti = int(megabyte * 1000 * 1000)
    try:
        stato, corpo, _primo, totale = https(SCARICO[0], SCARICO[1] % quanti, socks, attesa=90)
    except (OSError, ssl.SSLError) as e:
        r.nota("scaricamento di prova non riuscito", str(e)[:200])
        return
    if stato != 200 or len(corpo) < quanti * 0.95:
        r.nota("scaricamento di prova incompleto (%d di %d byte, risposta %d)" % (len(corpo), quanti, stato))
        return
    v = len(corpo) / totale / 1e6
    esito = r.ok if v >= 0.1 else r.nota
    esito("scaricati %.0f MB in %.1f s: %.2f MB/s (%.1f Mbit/s)" % (megabyte, totale, v, v * 8),
          "" if v >= 0.1 else "molto lento: un nodo del circuito ha poca banda («nyctalus-rete banda»)")


def controllo_chat(r, cfg, socks, contatto):
    r.titolo("7 · Chat e servizi della rete")
    porta, segreto = os.environ.get("NYCTALUS_CHAT_PORT"), os.environ.get("NYCTALUS_CHAT_TOKEN")
    if not (porta and segreto):
        try:
            p, s = (CASA / ".nyctalus-chat" / "controllo").read_text().split()[:2]
            porta, segreto = porta or p, segreto or s
        except (OSError, ValueError):
            pass
    if not porta:
        r.saltata("motore della chat", "non è acceso: apri la chat (o «nyctalus-cli avvia») e rilancia per controllarlo")
    else:
        try:
            with socket.create_connection(("127.0.0.1", int(porta)), timeout=5) as c:
                c.settimeout(6)
                c.sendall(("AUTH %s\nCASSAFORTE\nWHOAMI\nLIST\n" % segreto).encode())
                buf, fine = b"", time.time() + 6
                while time.time() < fine and b"ENDC" not in buf and b"CASSAFORTE chiusa" not in buf:
                    try:
                        d = c.recv(65536)
                    except socket.timeout:
                        break
                    if not d:
                        break
                    buf += d
            righe = buf.decode("utf-8", "replace").splitlines()
            if "CASSAFORTE chiusa" in righe:
                r.nota("motore della chat acceso ma CHIUSO: aspetta la passphrase", "sbloccalo dalla chat o con «nyctalus-cli sblocca»")
            else:
                io = next((x.split()[1] for x in righe if x.startswith("ME ")), "")
                if io:
                    r.ok("motore della chat acceso: %s…%s" % (io[:8], io[-10:]),
                         "%d contatti in rubrica" % sum(1 for x in righe if x.startswith("C ")))
                else:
                    r.ko("il motore della chat non risponde ai comandi")
                stato = next((x.split()[1] for x in righe if x.startswith("CASSAFORTE ") and len(x.split()) > 1), "")
                if stato == "aperta":
                    r.ok("dati della chat protetti da passphrase (cassaforte accesa)")
                elif stato:
                    r.nota("dati della chat in chiaro sul disco", "puoi proteggerli: «nyctalus-cli cassaforte attiva» o dalle Impostazioni")
        except OSError as e:
            r.ko("il motore della chat non risponde sulla porta %s" % porta, str(e))
    for k, cosa in (("rubrica", "rubrica della rete"), ("casella", "casella dei messaggi")):
        ind = str(cfg.get(k, ""))
        if not re.fullmatch(r"[a-z2-7]{56}\.nyct", ind):
            continue
        t0, errore_rete = time.time(), None
        for _giro in range(3):          # un circuito può passare da un nodo appena caduto: si riprova
            try:
                socks_connetti(socks, ind, 80, 60).close()
                errore_rete = None
                break
            except OSError as e:
                errore_rete = e
                time.sleep(4)
        if errore_rete is None:
            r.ok("%s raggiungibile dentro la rete (%.1f s)" % (cosa, time.time() - t0))
        else:
            e = errore_rete
            r.ko("%s NON raggiungibile (%s)" % (cosa, str(e)[:120]), "sul PC del gestore: «nyctalus-rete stato»")
    if contatto:
        cli = Path(__file__).resolve().parent / "nyctalus-cli"
        try:
            p = subprocess.run([sys.executable, str(cli), "scrivi", contatto,
                                "collaudo Nyctalus %s" % time.strftime("%H:%M:%S")], capture_output=True, text=True, timeout=90)
            (r.ok if p.returncode == 0 else r.ko)("messaggio di prova a «%s»" % contatto,
                                                  (p.stdout + p.stderr).strip().splitlines()[-1][:200] if (p.stdout + p.stderr).strip() else "")
        except (OSError, subprocess.TimeoutExpired) as e:
            r.ko("messaggio di prova a «%s»" % contatto, str(e))


