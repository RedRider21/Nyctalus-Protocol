COLORI = sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def col(codice, testo):
    return "\033[%sm%s\033[0m" % (codice, testo) if COLORI else testo


class Rapporto:
    """Gli esiti, nell'ordine: ok (✓), ko (✗), nota (!), saltata (–)."""
    SEGNI = {"ok": ("1;32", "✓"), "ko": ("1;31", "✗"), "nota": ("1;33", "!"), "saltata": ("2", "–")}

    def __init__(self):
        self.voci = []
        self.sezione = ""

    def titolo(self, testo):
        self.sezione = testo
        print("\n" + col("1;36", "── " + testo))

    def _metti(self, esito, testo, dettaglio=""):
        self.voci.append({"sezione": self.sezione, "esito": esito, "testo": testo, "dettaglio": dettaglio})
        colore, segno = self.SEGNI[esito]
        print("  %s %s%s" % (col(colore, segno), testo, ("\n      " + col("2", dettaglio)) if dettaglio else ""))

    def ok(self, t, d=""):
        self._metti("ok", t, d)

    def ko(self, t, d=""):
        self._metti("ko", t, d)

    def nota(self, t, d=""):
        self._metti("nota", t, d)

    def saltata(self, t, d=""):
        self._metti("saltata", t, d)

    def conta(self, esito):
        return sum(1 for v in self.voci if v["esito"] == esito)

    def testo(self):
        righe, sez = ["Collaudo Nyctalus — %s" % time.strftime("%d/%m/%Y %H:%M"), ""], None
        for v in self.voci:
            if v["sezione"] != sez:
                sez = v["sezione"]
                righe.append("── " + sez)
            righe.append("  %s %s" % (self.SEGNI[v["esito"]][1], v["testo"]))
            if v["dettaglio"]:
                righe.append("      " + v["dettaglio"])
        righe += ["", "Esito: %d superate, %d fallite, %d da guardare, %d saltate" % (
            self.conta("ok"), self.conta("ko"), self.conta("nota"), self.conta("saltata"))]
        return "\n".join(righe) + "\n"


# --- configurazione ---------------------------------------------------------------------
def leggi_json(p):
    try:
        return json.loads(Path(p).read_text())
    except (OSError, ValueError):
        return {}


def trova_configurazione(scelta):
    """(dove, config, porta SOCKS abituale). PC: ~/.nyctalus-browser; telefono/Windows:
    ~/.nyctalus-mobile (stessi campi, più le porte)."""
    pc, tel = CASA / ".nyctalus-browser" / "config.json", CASA / ".nyctalus-mobile" / "config.json"
    if scelta:
        c = leggi_json(scelta)
        return str(scelta), c, int((c.get("porte") or {}).get("socks", 1080))
    c_pc, c_tel = leggi_json(pc), leggi_json(tel)
    if c_tel.get("directory_url") and not c_pc.get("directory_url"):
        return str(tel), c_tel, int((c_tel.get("porte") or {}).get("socks", 18080))
    return str(pc), c_pc, 1080


def trova_motore():
    qui = Path(__file__).resolve().parent
    candidati = [os.environ.get("NYCTALUS_BIN"), qui / "bin" / "nyctalus", qui.parent / "bin" / "nyctalus",
                 qui.parents[1] / "target" / "release" / "nyctalus", shutil.which("nyctalus")]
    for c in candidati:
        if c and Path(c).is_file() and os.access(c, os.X_OK):
            return str(c)
    return None


def opzioni_protezione(cfg):
    """Le stesse opzioni che gli avvii passano al motore per la forma del traffico."""
    cam = str(cfg.get("camuffamento", ""))
    if not re.fullmatch(r"[0-9a-f]{64}", cam):
        return [], "nessuna (rete senza camuffamento)"
    op, nome = ["--obfuscation", cam], "camuffamento (rumore)"
    if cfg.get("forma") == "h3":
        op.append("--mimic")
        nome = "HTTP/3 (sembra un sito)"
        if re.fullmatch(r"[A-Za-z0-9.-]{1,253}", str(cfg.get("nome_h3", ""))):
            op += ["--mimic-name", cfg["nome_h3"]]
    elif cfg.get("forma") == "webrtc":
        op.append("--webrtc")
        nome = "videochiamata (WebRTC)"
    return op, nome


# --- SOCKS5 e HTTPS dentro il tunnel -------------------------------------------------------
def porta_aperta(host, porta, attesa=1.0):
    try:
        with socket.create_connection((host, porta), timeout=attesa):
            return True
    except OSError:
        return False


def socks_connetti(socks, host, porta, attesa=40):
    """Collegamento attraverso il tunnel. Il NOME viaggia dentro il tunnel (lo risolve l'uscita):
    questo computer non fa nessuna richiesta DNS."""
    s = socket.create_connection(socks, timeout=attesa)
    s.settimeout(attesa)
    s.sendall(b"\x05\x01\x00")
    if s.recv(2) != b"\x05\x00":
        s.close()
        raise OSError("il proxy SOCKS non risponde come previsto")
    nome = host.encode("idna")
    s.sendall(b"\x05\x01\x00\x03" + bytes([len(nome)]) + nome + porta.to_bytes(2, "big"))
    r = b""
    while len(r) < 4:
        d = s.recv(4 - len(r))
        if not d:
            raise OSError("il tunnel ha chiuso il collegamento")
        r += d
    if r[1] != 0:
        s.close()
        raise OSError("il tunnel non raggiunge %s (codice SOCKS %d)" % (host, r[1]))
    resto = {1: 6, 4: 18}.get(r[3])
    if resto is None:
        resto = s.recv(1)[0] + 2
    while resto > 0:
        resto -= len(s.recv(resto))
    return s


def https(host, percorso, socks=None, attesa=40, massimo=None):
    """GET https://host/percorso, in diretta o dal tunnel. → (stato, corpo, secondi al primo
    byte, secondi totali)."""
    t0 = time.time()
    grezzo = socks_connetti(socks, host, 443, attesa) if socks else socket.create_connection((host, 443), timeout=attesa)
    grezzo.settimeout(attesa)
    s = ssl.create_default_context().wrap_socket(grezzo, server_hostname=host)
    try:
        s.sendall(("GET %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: curl/8.5.0\r\nAccept: */*\r\nConnection: close\r\n\r\n"
                   % (percorso, host)).encode())
        dati, primo = b"", None
        while True:
            d = s.recv(65536)
            if not d:
                break
            primo = primo or time.time() - t0
            dati += d
            if massimo and len(dati) > massimo:
                break
    finally:
        s.close()
    testa, _, corpo = dati.partition(b"\r\n\r\n")
    stato = int(testa.split()[1]) if len(testa.split()) > 1 and testa.split()[1].isdigit() else 0
    if b"chunked" in testa.lower():
        intero, resto = b"", corpo
        while resto:
            riga, _, resto = resto.partition(b"\r\n")
            try:
                n = int(riga.split(b";")[0], 16)
            except ValueError:
                break
            if n == 0:
                break
            intero, resto = intero + resto[:n], resto[n + 2:]
        corpo = intero
    return stato, corpo, primo or 0.0, time.time() - t0


def che_ip(socks=None):
    """L'indirizzo che i servizi vedono (in diretta o dal tunnel): insieme di risposte valide."""
    visti, errori = set(), []
    for host, percorso in SERVIZI_IP:
        try:
            stato, corpo, _p, _t = https(host, percorso, socks)
            ip = corpo.decode("ascii", "replace").strip()
            if stato == 200 and re.fullmatch(r"[0-9a-fA-F:.]{3,45}", ip):
                visti.add(ip)
            else:
                errori.append("%s: risposta %s" % (host, stato))
        except (OSError, ssl.SSLError) as e:
            errori.append("%s: %s" % (host, e))
    return visti, errori


def maschera(ip):
    """Il tuo indirizzo vero non finisce intero nel rapporto."""
    if ":" in ip:
        return ":".join(ip.split(":")[:2]) + ":…"
    p = ip.split(".")
    return "%s.%s.x.x" % (p[0], p[1]) if len(p) == 4 else "…"


# --- ascolto del DNS (serve dumpcap o tcpdump con i permessi di cattura) ---------------------
class AscoltoDns:
    def __init__(self, cartella):
        self.file, self.proc, self.motivo = Path(cartella) / "dns.pcap", None, ""

    def avvia(self):
        filtro = "port 53 or port 853 or port 5353"
        for cmd in (["dumpcap", "-q", "-i", "any", "-f", filtro, "-w", str(self.file)],
                    ["tcpdump", "-i", "any", "-U", "-w", str(self.file), filtro]):
            if not shutil.which(cmd[0]):
                continue
            try:
                p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
            except OSError as e:
                self.motivo = str(e)
                continue
            time.sleep(1.5)
            if p.poll() is None:
                self.proc = p
                return True
            self.motivo = (p.stderr.read() or b"").decode("utf-8", "replace").strip().splitlines()[-1:] or [""]
            self.motivo = self.motivo[0][:160]
        if not self.motivo:
            self.motivo = "né dumpcap né tcpdump installati"
        return False

    def ferma(self):
        """→ i byte catturati (le richieste DNS in chiaro contengono i nomi così come sono)."""
        if not self.proc:
            return b""
        time.sleep(1.0)
        self.proc.terminate()
        try:
            self.proc.wait(5)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        try:
            return self.file.read_bytes()
        except OSError:
            return b""


def nome_nel_dns(cattura, host):
    """Il nome compare in una richiesta DNS catturata? (formato DNS: lunghezza + etichetta)"""
    codificato = b"".join(bytes([len(e)]) + e.encode() for e in host.split("."))
    return codificato in cattura or codificato.lower() in cattura.lower()


