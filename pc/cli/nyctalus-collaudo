def passi_guidati(r):
    r.titolo("8 · Passi da fare a mano")
    if not sys.stdin.isatty():
        r.saltata("passi guidati", "serve un terminale interattivo")
        return
    print("  Rispondi s (sì), n (no) o invio per saltare.\n")
    for domanda, nome in PASSI_GUIDATI:
        try:
            risposta = input("  ▸ %s [s/n/invio] " % domanda).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print()
            break
        if risposta.startswith("s"):
            r.ok(nome)
        elif risposta.startswith("n"):
            try:
                cosa = input("      cosa è successo? ").strip()
            except (EOFError, KeyboardInterrupt):
                cosa = ""
            r.ko(nome, cosa[:300])
        else:
            r.saltata(nome)


def main():
    ap = argparse.ArgumentParser(prog="nyctalus-collaudo", description="Il collaudo della tua rete Nyctalus su Internet vero.")
    ap.add_argument("--config", help="file di configurazione (di solito lo trova da solo)")
    ap.add_argument("--socks", help="tunnel già acceso da usare, es. 127.0.0.1:1080")
    ap.add_argument("--senza-diretto", action="store_true", help="non chiedere in diretta il tuo indirizzo vero (niente confronto)")
    ap.add_argument("--solo-rete", action="store_true", help="solo nodi, tunnel e servizi interni: niente prove verso Internet (IP, DNS, velocità)")
    ap.add_argument("--senza-velocita", action="store_true", help="salta la prova di velocità")
    ap.add_argument("--mb", type=float, default=3, help="megabyte da scaricare nella prova di velocità (3)")
    ap.add_argument("--contatto", help="manda anche un messaggio di prova a questo contatto")
    ap.add_argument("--guidato", action="store_true", help="aggiunge i passi da fare a mano (browser, chiamata, file…)")
    ap.add_argument("--rapporto", help="salva il rapporto in questo file di testo")
    ap.add_argument("--json", action="store_true", help="stampa gli esiti anche in JSON (ultima riga)")
    a = ap.parse_args()

    print(col("1", "Collaudo della rete Nyctalus") + col("2", "  ·  %s" % time.strftime("%d/%m/%Y %H:%M")))
    r = Rapporto()
    dove, cfg, porta_abituale = trova_configurazione(a.config)
    motore = trova_motore()
    proc = None
    with tempfile.TemporaryDirectory(prefix="nyctalus-collaudo-") as cartella:
        try:
            if controllo_configurazione(r, dove, cfg, motore):
                elenco = controllo_nodi(r, cfg, motore, cartella)
                socks, proc = prepara_tunnel(r, cfg, motore, elenco, cartella, porta_abituale, a.socks)
                if socks and a.solo_rete:
                    r.titolo("4-6 · Internet (IP, DNS, velocità)")
                    r.saltata("prove verso Internet", "--solo-rete")
                elif socks and controllo_ip(r, socks, a.senza_diretto):
                    controllo_dns(r, socks, cartella)
                    if a.senza_velocita:
                        r.titolo("6 · Velocità")
                        r.saltata("prova di velocità", "--senza-velocita")
                    else:
                        controllo_velocita(r, socks, max(0.2, min(a.mb, 200)))
                if socks:
                    controllo_chat(r, cfg, socks, a.contatto)
            if a.guidato:
                passi_guidati(r)
        except KeyboardInterrupt:
            print("\n  interrotto")
        finally:
            if proc:
                proc.terminate()
                try:
                    proc.wait(5)
                except subprocess.TimeoutExpired:
                    proc.kill()

    ko, note = r.conta("ko"), r.conta("nota")
    print("\n" + col("1", "═" * 60))
    riga = "%d superate · %d fallite · %d da guardare · %d saltate" % (r.conta("ok"), ko, note, r.conta("saltata"))
    if ko:
        print(col("1;31", "✗ COLLAUDO NON SUPERATO") + "   " + riga)
        for v in r.voci:
            if v["esito"] == "ko":
                print("   ✗ %s" % v["testo"])
    elif note:
        print(col("1;33", "✓ COLLAUDO SUPERATO, con cose da guardare") + "   " + riga)
    else:
        print(col("1;32", "✓ COLLAUDO SUPERATO") + "   " + riga)
    if a.rapporto:
        try:
            Path(a.rapporto).write_text(r.testo())
            print("  rapporto salvato in %s" % a.rapporto)
        except OSError as e:
            print("  rapporto non salvato: %s" % e)
    if a.json:
        print(json.dumps({"versione": VERSIONE, "voci": r.voci}, ensure_ascii=False))
    sys.exit(1 if ko else 0)


if __name__ == "__main__":
    main()
