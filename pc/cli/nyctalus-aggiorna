"""nyctalus-aggiorna — aggiorna Nyctalus sul PC dall'ultima release pubblicata su GitHub.

  nyctalus-aggiorna               controlla, chiede conferma, scarica, VERIFICA e installa
  nyctalus-aggiorna --controlla   dice soltanto se c'è una versione nuova (e quanto pesa)
  nyctalus-aggiorna --si          senza domande (lo usa il bottone «⬆ Aggiorna» del mini menu)
  nyctalus-aggiorna --json        (con --controlla) l'esito in JSON

Prima di installare verifica DUE cose, e se una non torna non installa nulla:
  1. la firma di SHA256SUMS con la chiave della release (la stessa di nyctalus-integrita);
  2. l'impronta del pacchetto scaricato contro quella elencata in SHA256SUMS.
Poi l'installatore controlla anche l'elenco d'integrità dentro il pacchetto. Una rete accesa
come servizio (nyctalus-casa, nyctalus-rubrica) viene riavviata con i programmi nuovi.

Il controllo NON parte mai da solo: contatta GitHub solo quando lo chiedi tu (GitHub vede
l'indirizzo da cui controlli, come per ogni scaricamento).
Codici di uscita: 0 fatto / già aggiornato, 10 (con --controlla) c'è una versione nuova,
1 errore o verifica fallita.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request
import zipfile
from pathlib import Path

REPO = "RedRider21/Nyctalus-Protocol"
API = os.environ.get("NYCTALUS_AGGIORNA_API") or "https://api.github.com/repos/%s/releases/latest" % REPO
SCARICA = os.environ.get("NYCTALUS_AGGIORNA_FILE") or "https://github.com/%s/releases/download/{tag}/{file}" % REPO
PACCHETTO = "Nyctalus-PC-Linux.zip"
IDENTITA, SPAZIO = "release@nyctalus", "nyctalus-release"
# chiave pubblica della release (firma/nyctalus-release.pub); NYCTALUS_FIRMA_INTEGRITA solo per le prove
CHIAVE = os.environ.get("NYCTALUS_FIRMA_INTEGRITA") or \
    "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIH2tSuN3+IVKV6CPiXCbkdT5FCyjciRePBoxVokIiiY"
QUI = Path(__file__).resolve().parent.parent          # radice dell'installazione (o pc/ nel progetto)
AGENTE = {"User-Agent": "nyctalus-aggiorna"}


def versione_installata():
    for f in (QUI / "VERSIONE", QUI.parent / "VERSIONE"):
        try:
            return f.read_text().strip()
        except OSError:
            continue
    return "0"


def come_numeri(v):
    return tuple(int(x) for x in re.findall(r"\d+", v)[:4]) or (0,)


def leggi(url, limite=64 * 1024 * 1024):
    req = urllib.request.Request(url, headers=AGENTE)
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read(limite)


def ultima():
    """→ (versione, tag, dimensione del pacchetto PC in byte o None)."""
    dati = json.loads(leggi(API, 2 * 1024 * 1024))
    tag = str(dati.get("tag_name", ""))
    if not re.fullmatch(r"v?\d+(\.\d+){1,3}", tag):
        raise ValueError("risposta di GitHub inattesa (tag «%s»)" % tag)
    peso = next((a.get("size") for a in dati.get("assets", []) if a.get("name") == PACCHETTO), None)
    return tag.lstrip("v"), tag, peso


def verifica_firma(somme, firma, cartella):
    if not shutil.which("ssh-keygen"):
        raise RuntimeError("manca ssh-keygen (pacchetto openssh-client): senza non posso verificare la firma")
    firmatari = cartella / "firmatari"
    firmatari.write_text('%s namespaces="%s" %s\n' % (IDENTITA, SPAZIO, CHIAVE))
    p = subprocess.run(["ssh-keygen", "-Y", "verify", "-f", str(firmatari), "-I", IDENTITA, "-n", SPAZIO,
                        "-s", str(firma)], stdin=open(somme, "rb"), capture_output=True, text=True)
    if p.returncode != 0:
        raise RuntimeError("la FIRMA della release non è valida: non installo nulla")


def impronta_attesa(somme, nome):
    for riga in Path(somme).read_text().splitlines():
        parti = riga.split()
        if len(parti) == 2 and parti[1].lstrip("*") == nome and re.fullmatch(r"[0-9a-f]{64}", parti[0]):
            return parti[0]
    raise RuntimeError("%s non è nell'elenco firmato SHA256SUMS" % nome)


def scarica_e_verifica(tag, cartella, dire=print):
    for f in ("SHA256SUMS", "SHA256SUMS.sig", PACCHETTO):
        dire("» scarico %s" % f)
        (cartella / f).write_bytes(leggi(SCARICA.format(tag=tag, file=f)))
    verifica_firma(cartella / "SHA256SUMS", cartella / "SHA256SUMS.sig", cartella)
    dire("✓ firma della release valida")
    h = hashlib.sha256((cartella / PACCHETTO).read_bytes()).hexdigest()
    if h != impronta_attesa(cartella / "SHA256SUMS", PACCHETTO):
        raise RuntimeError("l'impronta di %s NON corrisponde all'elenco firmato: non installo nulla" % PACCHETTO)
    dire("✓ impronta del pacchetto corrisponde all'elenco firmato")
    dest = cartella / "pacchetto"
    with zipfile.ZipFile(cartella / PACCHETTO) as z:
        for n in z.namelist():                      # niente percorsi che escono dalla cartella
            if n.startswith("/") or ".." in Path(n).parts:
                raise RuntimeError("pacchetto con percorsi non validi: %s" % n)
        z.extractall(dest)
        for info in z.infolist():                   # zipfile non rimette i permessi: motore e script
            modo = (info.external_attr >> 16) & 0o777
            if modo and not info.is_dir():
                os.chmod(dest / info.filename, modo)
    cand = [p for p in dest.rglob("installa.sh") if p.parent.name != "server"]   # quello del PC
    if not cand:
        raise RuntimeError("nel pacchetto manca installa.sh")
    return cand[0]


def riavvia_servizi(dire=print):
    # NYCTALUS_AGGIORNA_SERVIZI: altri nomi, solo per le prove (mai toccare i servizi veri)
    for unita in os.environ.get("NYCTALUS_AGGIORNA_SERVIZI", "nyctalus-casa.service nyctalus-rubrica.service").split():
        attivo = subprocess.run(["systemctl", "--user", "is-active", unita], capture_output=True, text=True).stdout.strip()
        if attivo in ("active", "activating"):
            subprocess.run(["systemctl", "--user", "restart", unita], capture_output=True)
            dire("✓ %s riavviato con i programmi nuovi" % unita)


def principale(argv):
    if "-h" in argv or "--help" in argv:
        print(__doc__)
        return 0
    attuale = versione_installata()
    try:
        nuova, tag, peso = ultima()
    except Exception as e:      # noqa: BLE001
        msg = "non riesco a controllare su GitHub: %s" % e
        print(json.dumps({"errore": msg}) if "--json" in argv else "✗ " + msg)
        return 1
    disponibile = come_numeri(nuova) > come_numeri(attuale)
    mb = ("%.1f MB" % (peso / 1e6)).replace(".", ",") if peso else "?"
    if "--controlla" in argv:
        if "--json" in argv:
            print(json.dumps({"installata": attuale, "ultima": nuova, "nuova": disponibile, "peso": peso,
                              "novita": "https://github.com/%s/releases/tag/%s" % (REPO, tag)}))
        else:
            print("Installata: %s · ultima pubblicata: %s%s" % (attuale, nuova, ("  → c'è una versione nuova (%s)" % mb) if disponibile else "  (sei aggiornato)"))
        return 10 if disponibile else 0
    if not disponibile:
        print("✓ Nyctalus %s è già l'ultima versione" % attuale)
        return 0
    print("Nyctalus %s → %s (pacchetto PC: %s)" % (attuale, nuova, mb))
    if "--si" not in argv:
        r = input("Scarico, verifico la firma e installo? [s/N] ").strip().lower()
        if r not in ("s", "si", "sì", "y"):
            print("Niente di fatto.")
            return 0
    with tempfile.TemporaryDirectory(prefix="nyctalus-aggiorna.") as t:
        try:
            inst = scarica_e_verifica(tag, Path(t))
        except Exception as e:  # noqa: BLE001
            print("✗ %s" % e)
            return 1
        print("» installo")
        p = subprocess.run(["bash", str(inst), "--si", "--ruolo", "gestore"], cwd=inst.parent,
                           stdin=subprocess.DEVNULL, capture_output=True, text=True)
        uscita = re.sub(r"\x1b\[[0-9;]*m", "", p.stdout + p.stderr)
        for riga in uscita.splitlines():
            if riga.startswith(("✓", "✗", "!")):
                print(riga)
        if p.returncode != 0:
            print("✗ installazione non riuscita (codice %d)" % p.returncode)
            return 1
    riavvia_servizi()
    print("✓ Nyctalus aggiornato alla %s. Chiudi e riapri chat, browser e mini menu." % nuova)
    return 0


if __name__ == "__main__":
    sys.exit(principale(sys.argv[1:]))
