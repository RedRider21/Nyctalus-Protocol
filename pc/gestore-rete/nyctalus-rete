            esci("prima firma l'elenco: nyctalus-rete firma")
        sys.exit(subprocess.run([binario(), "nodes", "--directory", str(rete.f_elenco), "--authority", a["pubblica"],
                                 "--probe"] + opz_prot(rete.protezione(), rumore=False)).returncode)
    elif cmd == "codice":
        url = opzione(args, "--url")
        if not url:
            esci("indica --url, l'indirizzo dove hai pubblicato directory.txt")
        # rubrica e casella accese su un'altra macchina (nyctalus-rete rubrica --codice … là)
        for chiave, nome_file in (("--rubrica", "indirizzo"), ("--casella", "casella-indirizzo")):
            v = opzione(args, chiave)
            if v:
                if not re.fullmatch(r"[a-z2-7]{56}\.nyct", v):
                    esci("%s: indirizzo .nyct non valido" % chiave)
                (privata(rete.dir / "rubrica") / nome_file).write_text(v + "\n")
        cod = rete.codice(url)
        ok("codice di rete (dallo ai client: contiene solo la chiave PUBBLICA e l'URL):")
        print("\n  %s\n" % cod)
        print("  Impronta della rete: %s (i client la vedono dopo l'importazione: deve essere uguale)"
              % impronta(rete.autorita()["pubblica"]))
        print("  Salvato anche in %s" % rete.f_codice)
    elif cmd == "servi":
        porta = int(opzione(args, "--porta", "18800"))
        ip = opzione(args, "--ip", ip_locale())
        if not rete.f_elenco.exists():
            esci("prima firma l'elenco: nyctalus-rete firma")
        _srv, url = servitore(rete, porta, ip)
        if not rete.f_codice.exists():
            rete.codice(url)
        ok("pubblico l'elenco su %s (Ctrl-C per smettere)" % url)
        print("  Codice di rete: %s" % rete.f_codice.read_text().strip())
        aspetta_ctrl_c()
    elif cmd == "casa":
        internet = opzione(args, "--internet")
        if internet is not None and not re.fullmatch(r"[A-Za-z0-9.-]{3,253}", internet):
            esci("--internet: indica il nome pubblico (es. miacasa.ddns.net) o l'IP pubblico")
        casa(int(opzione(args, "--nodi", "4")), int(opzione(args, "--porta-base", "4701")),
             int(opzione(args, "--porta", "18800")), opzione(args, "--ip", ip_locale()),
             "--non-importare" not in args, internet)
    elif cmd == "protezione":
        quale = "casa" if "--casa" in args else "internet" if "--internet" in args else None
        args = [a for a in args if a not in ("--casa", "--internet")]
        rumore = opzione(args, "--rumore")
        r = Rete(DATI / quale) if quale else Rete(DATI)
        if not r.esiste():
            esci("questa rete non esiste ancora" + (" (avvia prima: nyctalus-rete casa%s)" % (" --internet NOME" if quale == "internet" else "") if quale else ""))
        if args and args[0] in ("si", "sì", "no"):
            if rumore is not None:
                try:
                    rumore = float(rumore.replace(",", "."))
                    assert 0 < rumore <= 10
                except (ValueError, AssertionError):
                    esci("--rumore: un numero fra 0,1 e 10 (celle finte al secondo)")
            r.imposta_protezione(args[0] != "no", rumore if rumore is not None else RUMORE_DI_SERIE)
            if r.f_codice.exists():
                url = json.loads((r.dir / "nyctalus-rete.json").read_text()).get("directory_url") if (r.dir / "nyctalus-rete.json").exists() else None
                if url:
                    r.codice(url)
            ok("protezione %s" % ("accesa" if args[0] != "no" else "spenta"))
            print("  ⚠️  Il CODICE DI RETE è cambiato: ridallo a tutti (importatelo di nuovo) e riavvia la rete")
            print("     e i nodi sui server (con la nuova chiave di camuffamento, vedi sotto).")
        p = r.protezione()
        print("Camuffamento: %s" % ("acceso · chiave %s" % p["camuffamento"] if p.get("camuffamento") else "spento"))
        print("Rumore di fondo: %s" % ("%g celle finte al secondo" % p["rumore"] if p.get("rumore") else "spento"))
        if p.get("camuffamento"):
            print("Sui server dei nodi: ./installa.sh --camuffamento %s --rumore %g" % (p["camuffamento"], p.get("rumore", 0)))
    elif cmd == "ospite":
        internet = "--internet" in args
        if internet:
            args.remove("--internet")
        r = Rete(DATI / ("internet" if internet else "casa"))
        if not r.esiste():
            esci("prima avvia almeno una volta la rete: nyctalus-rete casa%s" % (" --internet NOME" if internet else ""))
        sotto = args.pop(0) if args else "elenco"
        prima = r.ospiti()
        if sotto == "aggiungi":
            famiglia = opzione(args, "--famiglia")
            if not famiglia or not FAMIGLIA.match(famiglia) or famiglia == "casa":
                esci("indica --famiglia NOME (il nome di chi gestisce quel nodo, es. --famiglia mario)")
            nuove = []
            for riga in args:
                riga = riga.strip().split()[-1] if riga.strip() else ""
                if not RIGA.match(riga):
                    esci("riga non valida: %r (atteso IP:PORTA,chiave,impronta)" % riga)
                nuove.append(",".join(riga.split(",")[:3] + [famiglia]))
            if not nuove:
                esci("indica le righe del nodo (le stampa «installa.sh» sul PC o server dell'amico)")
            indirizzi = {n.split(",")[0] for n in nuove}
            r.salva_ospiti([o for o in prima if o.split(",")[0] not in indirizzi] + nuove)
            r.rifirma_con_ospiti(prima)
            ok("%d nodi di «%s» aggiunti alla rete%s: l'elenco è già firmato e pubblicato" % (len(nuove), famiglia, " Internet" if internet else " di casa"))
            print("  Chi è già collegato li userà al prossimo avvio della chat.")
        elif sotto == "togli":
            if not args:
                esci("indica IP:PORTA del nodo ospite")
            resto = [o for o in prima if o.split(",")[0] != args[0]]
            if len(resto) == len(prima):
                esci("nessun nodo ospite %s" % args[0])
            r.salva_ospiti(resto)
            r.rifirma_con_ospiti(prima)
            ok("nodo ospite tolto e elenco rifirmato")
        elif sotto == "elenco":
            if not prima:
                print("Nessun nodo ospite. Aggiungine uno: nyctalus-rete ospite aggiungi RIGA --famiglia NOME")
            fam = {}
            for o in prima:
                fam.setdefault(o.split(",")[3], []).append(o.split(",")[0])
            for f, nodi in fam.items():
                print("  %-16s %s" % (f, ", ".join(nodi)))
            if prima:
                n = len(fam) + 1
                print("\nFamiglie in rete: %d (casa + %d ospiti). Per percorsi di 3 nodi tutti di gestori diversi" % (n, n - 1))
                print("ne servono almeno 3%s." % ("" if n >= 3 else ": per ora la rete funziona ma NON è anonima"))
        else:
            esci("uso: nyctalus-rete ospite aggiungi|togli|elenco")
    elif cmd == "rubrica":
        rubrica(opzione(args, "--codice"), "--servizio" in args, "--togli" in args, "--stampa" in args)
    elif cmd == "importa":
        if not args:
            esci("indica il codice di rete (o un file che lo contiene), oppure --prova")
        importa(args[0])
    elif cmd == "stato":
        stato_client()
    elif cmd == "reti":
        elenca_reti()
    elif cmd == "usa":
        if not args or not args[0].isdigit():
            esci("indica il numero della rete (nyctalus-rete reti per l'elenco)")
        usa_rete(int(args[0]))
    else:
        esci("comando sconosciuto: %s (nyctalus-rete --help)" % cmd)


if __name__ == "__main__":
    sys.stdout.reconfigure(line_buffering=True)
    principale(sys.argv[1:])
