# --- pubblicare l'elenco in rete locale -------------------------------------------------
def servitore(rete, porta, ip):
    """HTTP minimo: SOLO /directory.txt e una pagina col codice (niente altro file)."""
    class Gestore(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path == "/directory.txt" and rete.f_elenco.exists():
                corpo, tipo = rete.f_elenco.read_bytes(), "text/plain; charset=utf-8"
            elif self.path in ("/", "/codice") and rete.f_codice.exists():
                cod = rete.f_codice.read_text().strip()
                imp = impronta(rete.autorita()["pubblica"])
                q = urllib.parse.quote(cod, safe="")
                # Chrome su Android apre le app in modo affidabile con un link «intent:»;
                # il link nyctalus:// resta per gli altri browser.
                intent = "intent://rete?codice=%s#Intent;scheme=nyctalus;package=org.nyctalus.mobile;end" % q
                diretto = "nyctalus://rete?codice=" + q
                corpo = ("<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width'>"
                         "<title>Codice di rete Nyctalus</title><body style='font:16px sans-serif;padding:16px;"
                         "background:#0a0e1a;color:#e6ecff'><h2>Rete «%s»</h2>"
                         "<p>Impronta: <b style='font-size:20px;letter-spacing:1px'>%s</b></p>"
                         "<p><a href='%s' style='display:block;text-align:center;padding:16px;border-radius:14px;"
                         "background:linear-gradient(135deg,#5ec8d8,#8a86ff);color:#06101c;font-weight:700;"
                         "font-size:18px;text-decoration:none'>📲 Collega l'app Nyctalus</a></p>"
                         "<p style='text-align:center;font-size:14px'><a href='%s' style='color:#8a86ff'>non si apre? "
                         "prova questo link</a></p>"
                         "<p style='color:#9aa7b8'>Tocca il pulsante: si apre l'app e ti chiede conferma. Controlla che "
                         "l'impronta sia la stessa.<br>Altrimenti: <b>Copia il codice</b> qui sotto, poi nell'app tocca "
                         "«🔗 Rete» → Importa codice di rete (lo trova già incollato).</p>"
                         "<button onclick=\"var t=document.getElementById('c');t.select();document.execCommand('copy');"
                         "this.textContent='✓ Copiato'\" style='width:100%%;padding:14px;border-radius:12px;border:1px solid #2a3550;"
                         "background:#151a23;color:#e6ecff;font-size:16px'>📋 Copia il codice</button>"
                         "<textarea id='c' readonly style='width:100%%;height:8em;margin-top:10px;font:14px monospace'>%s</textarea>"
                         % (html.escape(rete.autorita()["nome"]), imp, html.escape(intent, quote=True),
                            html.escape(diretto, quote=True), cod)).encode()
                tipo = "text/html; charset=utf-8"
            else:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", tipo)
            self.send_header("Content-Length", str(len(corpo)))
            self.send_header("Cache-Control", "no-cache")
            self.end_headers()
            self.wfile.write(corpo)

        def log_message(self, *a):
            pass

    srv = http.server.ThreadingHTTPServer(("0.0.0.0", porta), Gestore)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv, "http://%s:%d/directory.txt" % (ip, porta)


def aspetta_ctrl_c():
    fermo = threading.Event()
    signal.signal(signal.SIGTERM, lambda *a: fermo.set())
    signal.signal(signal.SIGINT, signal.default_int_handler)   # anche se avviato da chi ignora Ctrl-C
    try:
        while not fermo.wait(1):
            pass
    except KeyboardInterrupt:
        pass


# --- rete di casa: tutto su questo PC ---------------------------------------------------
def apri_firewall_internet(porta_web, porte_nodi, cartella):
    """Rete raggiungibile da Internet: le porte vanno aperte a tutti (il router poi le inoltra)."""
    fw = firewall_chiuso()
    if not fw:
        return
    if fw == "ufw":
        comandi = [["ufw", "allow", "%d/tcp" % porta_web], ["ufw", "allow", "%d:%d/udp" % (porte_nodi[0], porte_nodi[-1])]]
    else:
        comandi = [["firewall-cmd", "--add-port=%d/tcp" % porta_web, "--add-port=%d-%d/udp" % (porte_nodi[0], porte_nodi[-1])]]
    segno = cartella / "firewall-aperto"
    firma = "%s internet %d %d-%d" % (fw, porta_web, porte_nodi[0], porte_nodi[-1])
    if segno.exists() and segno.read_text().strip() == firma:
        return
    print("\n⚠️  Il firewall del PC (%s) bloccherebbe chi arriva da Internet." % fw)
    if sys.stdin.isatty():
        r = input("   Apro le porte UDP %d-%d e TCP %d? Serve la password. [S/n] "
                  % (porte_nodi[0], porte_nodi[-1], porta_web)).strip().lower()
        if r in ("", "s", "si", "sì", "y", "yes"):
            if all(subprocess.run(["sudo"] + c).returncode == 0 for c in comandi):
                segno.write_text(firma + "\n")
                ok("porte aperte")
                return
            print("   Non riuscito.")
    print("   Aprile tu, una volta sola:")
    for c in comandi:
        print("     sudo " + " ".join(c))


def casa(nodi, porta_base, porta_web, ip, importa_qui, internet=None):
    """Rete di casa sul PC. Con `internet` (un nome tipo miacasa.ddns.net, o l'IP pubblico) la
    stessa rete si raggiunge da Internet: è una rete a sé («Rete Internet di prova»), i nodi si
    annunciano col nome e l'elenco si scarica da http://NOME:porta/."""
    privata(DATI)
    lan = ip
    if internet:
        ip = internet
    r = Rete(privata(DATI / ("internet" if internet else "casa")))
    if not r.esiste():
        r.crea("Rete Internet di prova" if internet else "Rete di casa")
    b, proc, righe = binario(), [], []
    try:
        for i in range(nodi):
            porta = porta_base + i
            d = r.dir / ("nodo-%d" % porta)
            (d / "riga-elenco.txt").unlink(missing_ok=True)
            log = open(r.dir / ("nodo-%d.log" % porta), "ab")
            proc.append(subprocess.Popen([b, "node", "--listen", "0.0.0.0:%d" % porta, "--data", str(d),
                                          "--announce", "%s:%d" % (ip, porta)] + opz_prot(r.protezione()),
                                         stdout=log, stderr=log,
                                         start_new_session=True))
        for i in range(nodi):
            f = r.dir / ("nodo-%d" % (porta_base + i)) / "riga-elenco.txt"
            for _ in range(100):
                if f.exists() and f.read_text().strip():
                    break
                if proc[i].poll() is not None:
                    esci("il nodo sulla porta %d non parte (porta occupata?) — vedi %s"
                         % (porta_base + i, r.dir / ("nodo-%d.log" % (porta_base + i))))
                time.sleep(0.1)
            righe.append(f.read_text().strip())
        ospiti = r.ospiti()                                   # nodi di amici, con la loro famiglia
        if ospiti:
            # con nodi di altri, quelli di questo PC si dichiarano UNA famiglia (stesso gestore):
            # mai due nello stesso percorso. Senza ospiti l'elenco resta quello di sempre, leggibile
            # anche dai client prima della 0.3.3.
            righe = [",".join(x.split(",")[:3] + ["casa"]) for x in righe]
        r.salva_nodi(righe + ospiti)
        r.firma()
        if ospiti:
            print("» nodi ospiti nella rete: %d (%s)" % (len(ospiti), ", ".join(o.split(",")[0] for o in ospiti)))
        avvia_rubrica(r, r.autorita()["pubblica"], proc)      # chi usa la rete vede chi c'è
        srv, url = servitore(r, porta_web, ip)
        cod = r.codice(url)
        imp = impronta(r.autorita()["pubblica"])
        if internet:
            apri_firewall_internet(porta_web, [porta_base + i for i in range(nodi)], r.dir)
        else:
            apri_firewall(porta_web, [porta_base + i for i in range(nodi)], ip, r.dir)
        if importa_qui:
            importa(cod)
        if internet:
            ultima = porta_base + nodi - 1
            print("\n🌍 Rete raggiungibile da Internet come «%s» · %d nodi · impronta %s\n" % (internet, nodi, imp))
            print("Sul ROUTER inoltra verso questo PC (%s) — una volta sola:" % lan)
            print("  • UDP %d-%d   (i nodi)" % (porta_base, ultima))
            print("  • TCP %d       (l'elenco dei nodi e la pagina del codice)" % porta_web)
            print("\nProva dei nodi attraverso il nome pubblico (da questo PC):")
            esito = subprocess.run([b, "nodes", "--directory", str(r.f_elenco), "--authority",
                                    r.autorita()["pubblica"], "--probe"] + opz_prot(r.protezione(), rumore=False),
                                   capture_output=True, text=True, timeout=60)
            print("  " + (esito.stdout.strip() or esito.stderr.strip()).replace("\n", "\n  "))
            if esito.returncode != 0:
                print("  ⚠️  Da qui i nodi non rispondono col nome pubblico. Cause tipiche:")
                print("     - il nome non punta ancora all'IP attuale (No-IP: aggiornamento in corso?)")
                print("     - inoltro delle porte mancante sul router")
                print("     - il router non fa «tornare indietro» i pacchetti verso il proprio nome (NAT")
                print("       loopback): allora SOLO su questo PC aggiungi a /etc/hosts la riga")
                print("         127.0.0.1 %s" % internet)
                print("     - linea senza IP pubblico (CGNAT): l'inoltro delle porte non può funzionare")
            print("\nPer chi si collega (anche da un'altra città):")
            print("  • telefono: apri nel browser  http://%s:%d/  e tocca «📲 Collega l'app Nyctalus»" % (internet, porta_web))
            print("  • PC:       nyctalus-rete importa '%s'" % cod)
            print("  • l'impronta mostrata dopo l'importazione deve essere %s (confrontatela a voce)" % imp)
            print("\nLascia questa finestra aperta: Ctrl-C ferma la rete.")
            aspetta_ctrl_c()
            srv.shutdown()
            return
        print("\n🦇 Rete di casa attiva su questo PC (%s) · %d nodi · impronta %s\n" % (ip, nodi, imp))
        print("Ora:")
        print("  1. Sul telefono (stessa Wi-Fi), nel browser:  http://%s:%d/" % (ip, porta_web))
        print("     e tocca «📲 Collega l'app Nyctalus». Conferma nell'app: impronta %s." % imp)
        print("  2. Sul PC apri la Chat (mini menu → Chat); sul telefono apri la Chat.")
        print("  3. Scambiatevi i Contact ID e aggiungetevi:  + sul PC, ✏️ sul telefono.")
        print("\n  Codice di rete, se serve a mano: %s" % cod)
        print("\nLascia questa finestra aperta: Ctrl-C ferma la rete di casa.")
        aspetta_ctrl_c()
        srv.shutdown()
    finally:
        for p in proc:
            try:
                os.killpg(p.pid, signal.SIGTERM)
            except Exception:  # noqa: BLE001
                pass
        print("\n%s fermata." % ("Rete Internet di prova" if internet else "Rete di casa"))


# --- rubrica + casella di una rete (anche fuori dalla rete di casa) ---------------------
UNITA_RUBRICA = Path.home() / ".config" / "systemd" / "user" / "nyctalus-rubrica.service"
AGGIORNA_ELENCO = 6 * 3600


def rubrica(codice=None, servizio=False, togli=False, stampa=False):
    """Rubrica e casella cifrata per una rete vera: per quella che gestisci su questo PC, o per
    quella di un codice (es. sul server, che non ha la chiave dell'autorità)."""
    if servizio:
        cmd = "%s %s rubrica%s" % (sys.executable, Path(__file__).resolve(), " --codice " + codice if codice else "")
        testo = ("# Creato da nyctalus-rete: rubrica e casella cifrata della rete, sempre accese.\n"
                 "[Unit]\nDescription=Nyctalus: rubrica e casella della rete\nWants=network-online.target\n"
                 "After=network-online.target\n\n[Service]\nExecStart=%s\nEnvironment=NYCTALUS_BIN=%s\n"
                 "Restart=always\nRestartSec=15\n\n[Install]\nWantedBy=default.target\n" % (cmd, binario()))
        if stampa:
            return print(testo, end="")
        if togli:
            subprocess.run(["systemctl", "--user", "disable", "--now", UNITA_RUBRICA.name], capture_output=True)
            UNITA_RUBRICA.unlink(missing_ok=True)
            subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
            return ok("rubrica e casella non sono più sempre accese")
        UNITA_RUBRICA.parent.mkdir(parents=True, exist_ok=True)
        UNITA_RUBRICA.write_text(testo)
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        r = subprocess.run(["systemctl", "--user", "enable", "--now", UNITA_RUBRICA.name], capture_output=True, text=True)
        if r.returncode != 0:
            esci("systemd non l'ha avviata: %s" % r.stderr.strip())
        ok("rubrica e casella sempre accese (servizio %s)" % UNITA_RUBRICA.name)
        print("  Gli indirizzi da mettere nel codice: journalctl --user -u %s | grep -E 'Rubrica|Casella'" % UNITA_RUBRICA.name)
        print("  Per tenerle accese anche senza essere collegati: sudo loginctl enable-linger %s" % os.environ.get("USER", "$USER"))
        return
    if codice:                                 # la rete di un codice (qui non c'è l'autorità)
        try:
            dati = leggi_codice(codice)
        except ValueError as e:
            esci(str(e))
        d = privata(privata(DATI / "rubriche") / impronta(dati["authority"]))
        r = types.SimpleNamespace(dir=d, f_elenco=d / "directory.txt")
        aut, nome, url = dati["authority"], dati["nome"], dati["directory_url"]
    else:
        rr = Rete(DATI)
        if not rr.esiste():
            esci("questo PC non gestisce una rete: indica il codice della rete con --codice NYCT1:…")
        if not rr.f_elenco.exists():
            esci("prima firma l'elenco: nyctalus-rete firma")
        r, aut, nome, url = rr, rr.autorita()["pubblica"], rr.autorita()["nome"], None

    def scarica():                             # l'elenco dei nodi (solo per la rete di un codice)
        if not url:
            return False
        with urllib.request.urlopen(url, timeout=30) as risp:
            nuovo = risp.read(1024 * 1024)
        vecchio = r.f_elenco.read_bytes() if r.f_elenco.exists() else b""
        r.f_elenco.write_bytes(nuovo)
        return nuovo != vecchio

    if url:
        try:
            scarica()
        except Exception as e:  # noqa: BLE001
            if not r.f_elenco.exists():
                esci("non riesco a scaricare l'elenco dei nodi da %s: %s" % (url, e))
    fermo = threading.Event()
    signal.signal(signal.SIGTERM, lambda *a: fermo.set())
    try:
        while not fermo.is_set():
            proc = []
            rub = avvia_rubrica(r, aut, proc, prot_da_codice(dati) if codice else None)
            f_cas = r.dir / "rubrica" / "casella-indirizzo"
            cas = f_cas.read_text().strip() if f_cas.exists() else "(non partita)"
            print("\n🦇 Rubrica e casella della rete «%s» accese" % nome)
            print("   Rubrica: %s" % rub)
            print("   Casella: %s" % cas)
            if codice:
                print("\n   Manda questi due indirizzi a chi gestisce la rete, che rifà il codice così:")
                print("   nyctalus-rete codice --url URL --rubrica %s --casella %s" % (rub, cas))
            else:
                print("\n   Rifai il codice di rete (li include da solo):  nyctalus-rete codice --url URL")
            print("   Lascia acceso (Ctrl-C ferma; sempre accese: nyctalus-rete rubrica%s --servizio)"
                  % (" --codice …" if codice else ""))
            prossimo = time.time() + AGGIORNA_ELENCO
            try:
                while not fermo.wait(5):
                    if time.time() > prossimo:
                        prossimo = time.time() + AGGIORNA_ELENCO
                        try:
                            if scarica():
                                print("» elenco dei nodi cambiato: riavvio rubrica e casella")
                                break
                        except Exception:  # noqa: BLE001
                            pass
            except KeyboardInterrupt:
                fermo.set()
            for p in proc:
                try:
                    os.killpg(p.pid, signal.SIGTERM)
                except Exception:  # noqa: BLE001
                    pass
            time.sleep(1)
    finally:
        print("\nRubrica e casella fermate.")


# --- riga di comando --------------------------------------------------------------------
def opzione(args, nome, predefinito=None):
    if nome in args:
        i = args.index(nome)
        if i + 1 >= len(args):
            esci("manca il valore di " + nome)
        v = args[i + 1]
        del args[i:i + 2]
        return v
    return predefinito


