DATI = Path(os.environ.get("NYCTALUS_RETE_DATI", Path.home() / ".nyctalus-rete"))
CONFIG_CLIENT = Path.home() / ".nyctalus-browser" / "config.json"     # lo leggono chat e browser del PC
PREFISSO = "NYCT1:"
RIGA = re.compile(r"^(\[?[0-9A-Za-z.:-]+\]?):(\d{1,5}),([0-9a-f]{64}),([0-9a-f]{64})(,[A-Za-z0-9_.-]{1,32})?$")
FAMIGLIA = re.compile(r"^[A-Za-z0-9_.-]{1,32}$")


def esci(msg, codice=1):
    print("✗ " + msg, file=sys.stderr)
    sys.exit(codice)


def ok(msg):
    print("✓ " + msg)


def binario():
    """Il motore: variabile NYCTALUS_BIN, installazione, PATH, sorgenti compilati."""
    qui = Path(__file__).resolve().parent
    for c in (os.environ.get("NYCTALUS_BIN"), qui.parent / "bin" / "nyctalus", shutil.which("nyctalus"),
              qui.parents[1] / "target" / "release" / "nyctalus"):
        if c and Path(c).is_file() and os.access(c, os.X_OK):
            return str(c)
    esci("motore «nyctalus» non trovato (installa Nyctalus o imposta NYCTALUS_BIN)")


def privata(cartella):
    cartella.mkdir(parents=True, exist_ok=True)
    os.chmod(cartella, 0o700)
    return cartella


def scrivi_privato(percorso, testo):
    fd = os.open(percorso, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(testo)
    os.chmod(percorso, 0o600)


def impronta(pubblica):
    """Impronta breve della rete (dalla chiave pubblica dell'autorità): si confronta a occhio
    fra PC e telefono per essere sicuri di aver importato il codice giusto."""
    h = __import__("hashlib").sha256(bytes.fromhex(pubblica)).hexdigest()[:8].upper()
    return h[:4] + "-" + h[4:]


def firewall_chiuso():
    """Il firewall del PC scarta le richieste dalla rete locale? (ufw o firewalld attivi)"""
    try:
        conf = Path("/etc/ufw/ufw.conf").read_text()
        if re.search(r"^ENABLED=yes", conf, re.M):
            return "ufw"
    except OSError:
        pass
    if shutil.which("firewall-cmd") and subprocess.run(["firewall-cmd", "--state"], capture_output=True).returncode == 0:
        return "firewalld"
    return None


def apri_firewall(porta_web, porte_nodi, ip, cartella):
    """Se il firewall blocca il telefono, si offre di aprire le porte SOLO verso la rete
    di casa (chiede conferma e la password di sudo). Ricorda di averlo fatto."""
    fw = firewall_chiuso()
    if not fw:
        return
    rete = ".".join(ip.split(".")[:3]) + ".0/24"
    if fw == "ufw":
        comandi = [["ufw", "allow", "from", rete, "to", "any", "port", str(porta_web), "proto", "tcp"],
                   ["ufw", "allow", "from", rete, "to", "any", "port", "%d:%d" % (porte_nodi[0], porte_nodi[-1]), "proto", "udp"]]
    else:
        comandi = [["firewall-cmd", "--add-port=%d/tcp" % porta_web, "--add-port=%d-%d/udp" % (porte_nodi[0], porte_nodi[-1])]]
    segno = cartella / "firewall-aperto"
    firma = "%s %s %d %d-%d" % (fw, rete, porta_web, porte_nodi[0], porte_nodi[-1])
    if segno.exists() and segno.read_text().strip() == firma:
        return                                        # già aperte l'altra volta
    print("\n⚠️  Il firewall del PC (%s) blocca il telefono (la pagina resterebbe a caricare)." % fw)
    if sys.stdin.isatty():
        r = input("   Apro le porte solo verso la rete di casa %s? Serve la password. [S/n] " % rete).strip().lower()
        if r in ("", "s", "si", "sì", "y", "yes"):
            if all(subprocess.run(["sudo"] + c).returncode == 0 for c in comandi):
                segno.write_text(firma + "\n")
                ok("porte aperte per la rete di casa")
                return
            print("   Non riuscito.")
    print("   Aprile tu, una volta sola:")
    for c in comandi:
        print("     sudo " + " ".join(c))
    print("   (per richiuderle: le stesse righe con «delete allow» al posto di «allow»)")


def ip_locale():
    """L'indirizzo di questo PC nella rete locale (nessun pacchetto viene spedito)."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.0.2.1", 9))
        return s.getsockname()[0]
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


# --- protezione della rete (PIANO-ANONIMATO, Tappa 4) -----------------------------------
RUMORE_DI_SERIE = 0.2          # celle finte al secondo (circa 20 MB al giorno): leggero anche sul telefono


def prot_da_codice(cfg):
    """Camuffamento e rumore dal codice di rete (validati): {} se la rete non li usa."""
    out = {}
    if re.fullmatch(r"[0-9a-f]{64}", str(cfg.get("camuffamento", ""))):
        out["camuffamento"] = cfg["camuffamento"]
    try:
        r = float(cfg.get("rumore", 0))
        if 0 < r <= 10:
            out["rumore"] = r
    except (TypeError, ValueError):
        pass
    return out


def opz_prot(prot, rumore=True):
    """Opzioni del motore per camuffamento (e rumore) della rete."""
    o = []
    if prot.get("camuffamento"):
        o += ["--obfuscation", prot["camuffamento"]]
    if rumore and prot.get("rumore"):
        o += ["--cover", "%g" % prot["rumore"]]
    return o


# --- la rete del gestore ---------------------------------------------------------------
class Rete:
    def __init__(self, cartella):
        self.dir = cartella
        self.f_aut = cartella / "autorita.json"
        self.f_nodi = cartella / "nodi.txt"
        self.f_elenco = cartella / "directory.txt"
        self.f_codice = cartella / "codice.txt"
        self.f_ospiti = cartella / "ospiti.txt"     # nodi di altri inclusi nella rete di casa
        self.f_prot = cartella / "protezione.json"   # camuffamento e rumore di fondo della rete

    def _prot_file(self):
        try:
            return json.loads(self.f_prot.read_text())
        except (OSError, ValueError):
            return {}

    def protezione(self):
        d = self._prot_file()
        if d.get("attiva") is False:
            return {}                               # spenta (la chiave resta da parte)
        return prot_da_codice(d)                    # reti nate prima della 0.3.4: nessun file = spenta

    def imposta_protezione(self, accesa, rumore=RUMORE_DI_SERIE):
        # la chiave si conserva anche da spenta: riaccendendo, i nodi già installati vanno ancora bene
        vecchia = self._prot_file().get("camuffamento")
        if not re.fullmatch(r"[0-9a-f]{64}", str(vecchia or "")):
            vecchia = None
        prot = {"attiva": bool(accesa), "camuffamento": vecchia or os.urandom(32).hex(), "rumore": rumore}
        scrivi_privato(self.f_prot, json.dumps(prot, indent=1))

    def ospiti(self):
        if not self.f_ospiti.exists():
            return []
        return [r.strip() for r in self.f_ospiti.read_text().splitlines() if RIGA.match(r.strip())]

    def salva_ospiti(self, righe):
        scrivi_privato(self.f_ospiti, "".join(r + "\n" for r in righe))

    def rifirma_con_ospiti(self, prima=()):
        """I nodi propri (quelli che non erano ospiti) più gli ospiti di adesso: elenco rifirmato."""
        vecchi = {r.split(",")[0] for r in prima} | {r.split(",")[0] for r in self.ospiti()}
        propri = [",".join(r.split(",")[:3] + (["casa"] if self.ospiti() else []))
                  for r in self.nodi() if r.split(",")[0] not in vecchi]
        self.salva_nodi(propri + self.ospiti())
        if self.f_aut.exists() and len(propri) + len(self.ospiti()) >= 3:
            self.firma()

    def esiste(self):
        return self.f_aut.exists()

    def autorita(self):
        if not self.esiste():
            esci("nessuna rete: prima «nyctalus-rete crea»")
        return json.loads(self.f_aut.read_text())

    def crea(self, nome, sostituisci=False):
        if self.esiste() and not sostituisci:
            esci("la rete esiste già (%s). Per ricominciare da capo: --sostituisci "
                 "(i client andranno ricollegati con un codice nuovo)" % self.f_aut)
        out = subprocess.run([binario(), "authority"], capture_output=True, text=True, check=True).stdout
        seg = re.search(r"secret:\s+([0-9a-f]{64})", out).group(1)
        pub = re.search(r"public:\s+([0-9a-f]{64})", out).group(1)
        if self.dir.parent == DATI:
            privata(DATI)
        privata(self.dir)
        scrivi_privato(self.f_aut, json.dumps({"nome": nome, "segreto": seg, "pubblica": pub,
                                               "creata": time.strftime("%Y-%m-%d %H:%M")}, indent=1))
        self.imposta_protezione(True)               # reti nuove: camuffamento e rumore di serie
        if sostituisci:
            for f in (self.f_nodi, self.f_elenco, self.f_codice):
                f.unlink(missing_ok=True)
        return pub

    def nodi(self):
        if not self.f_nodi.exists():
            return []
        return [r.strip() for r in self.f_nodi.read_text().splitlines() if RIGA.match(r.strip())]

    def salva_nodi(self, righe):
        scrivi_privato(self.f_nodi, "".join(r + "\n" for r in righe))

    def aggiungi(self, righe, famiglia=None):
        if famiglia is not None and not FAMIGLIA.match(famiglia):
            esci("nome di famiglia non valido: lettere, cifre, _ . - (al massimo 32)")
        attuali = self.nodi()
        nuove = 0
        for r in righe:
            r = r.strip()
            if not r or r.startswith("#"):
                continue
            r = r.split()[-1] if " " in r else r          # accetta anche «directory entry:   …»
            if not RIGA.match(r):
                esci("riga non valida: %r (atteso IP:PORTA,chiave,impronta)" % r)
            if famiglia:
                r = ",".join(r.split(",")[:3] + [famiglia])
            indirizzo = r.split(",")[0]
            attuali = [a for a in attuali if a.split(",")[0] != indirizzo] + [r]
            nuove += 1
        self.salva_nodi(attuali)
        return nuove, len(attuali)

    def famiglia(self, indirizzo, nome):
        """Mette (nome) o toglie (None) un nodo da una famiglia."""
        if nome is not None and not FAMIGLIA.match(nome):
            esci("nome di famiglia non valido: lettere, cifre, _ . - (al massimo 32)")
        attuali, trovato = [], False
        for a in self.nodi():
            if a.split(",")[0] == indirizzo:
                a, trovato = ",".join(a.split(",")[:3] + ([nome] if nome else [])), True
            attuali.append(a)
        if not trovato:
            esci("nodo non trovato: " + indirizzo)
        self.salva_nodi(attuali)

    def togli(self, indirizzo):
        attuali = self.nodi()
        resto = [a for a in attuali if a.split(",")[0] != indirizzo]
        self.salva_nodi(resto)
        return len(attuali) - len(resto)

    def firma(self):
        a, nodi = self.autorita(), self.nodi()
        if len(nodi) < 3:
            esci("servono almeno 3 nodi (ogni percorso ne usa 3 diversi): ora sono %d" % len(nodi))
        out = subprocess.run([binario(), "directory", "--authority-secret", a["segreto"], "--entries", ";".join(nodi)],
                             capture_output=True, text=True)
        if out.returncode != 0 or "firma" not in out.stdout:
            esci("firma non riuscita: " + (out.stderr or out.stdout).strip())
        self.f_elenco.write_text(out.stdout)
        return self.f_elenco

    def codice(self, url):
        if not re.match(r"^https?://[^\s]+$", url):
            esci("URL non valido: deve iniziare con http:// o https://")
        a = self.autorita()
        cfg = {"v": 1, "nome": a["nome"], "directory_url": url, "authority": a["pubblica"]}
        cfg.update(self.protezione())               # camuffamento e rumore: li usano anche i client
        for chiave, nome_file in (("rubrica", "indirizzo"), ("casella", "casella-indirizzo")):
            f = self.dir / "rubrica" / nome_file
            if f.exists():
                cfg[chiave] = f.read_text().strip()      # rubrica e casella di questa rete (se accese)
        cod = PREFISSO + base64.urlsafe_b64encode(json.dumps(cfg, separators=(",", ":")).encode()).decode().rstrip("=")
        self.f_codice.write_text(cod + "\n")
        (self.dir / "nyctalus-rete.json").write_text(json.dumps(cfg, indent=1) + "\n")
        return cod


# --- codice di rete (anche per i client) ------------------------------------------------
def leggi_codice(testo):
    """Codice NYCT1:… oppure il JSON della rete → dict validato."""
    testo = testo.strip()
    if testo.startswith(PREFISSO):
        b = testo[len(PREFISSO):]
        try:
            cfg = json.loads(base64.urlsafe_b64decode(b + "=" * (-len(b) % 4)))
        except Exception:     # noqa: BLE001
            raise ValueError("codice di rete rovinato (copialo per intero)")
    else:
        try:
            cfg = json.loads(testo)
        except Exception:     # noqa: BLE001
            raise ValueError("non è un codice di rete Nyctalus (deve iniziare con %s)" % PREFISSO)
    url, aut = str(cfg.get("directory_url", "")), str(cfg.get("authority", ""))
    if not re.match(r"^https?://[^\s]+$", url) or not re.fullmatch(r"[0-9a-f]{64}", aut):
        raise ValueError("codice di rete incompleto")
    rete = {"nome": str(cfg.get("nome") or "Rete Nyctalus")[:60], "directory_url": url, "authority": aut}
    for k in ("rubrica", "casella"):                     # rubrica e casella della rete
        if re.fullmatch(r"[a-z2-7]{56}\.nyct", str(cfg.get(k, ""))):
            rete[k] = cfg[k]
    rete.update(prot_da_codice(cfg))                     # camuffamento e rumore della rete
    return rete


# --- rubrica della rete ------------------------------------------------------------------
PORTE_RUBRICA = [int(x) for x in os.environ.get("NYCTALUS_RUBRICA_PORTE", "18810,18811,18812,18813,18814").split(",")]


def avvia_rubrica(rete, autorita_pub, proc, prot=None):
    """Accende la rubrica della rete: un motore della chat con la sua identità, il suo
    collegamento alla rete, il suo servizio .nyct e il programma rubrica.py. Restituisce
    l'indirizzo .nyct della rubrica (scritto anche in rubrica/indirizzo per il codice)."""
    b = binario()
    d = privata(rete.dir / "rubrica")
    prot = prot if prot is not None else (rete.protezione() if hasattr(rete, "protezione") else {})
    backend, controllo, socks, monitor = PORTE_RUBRICA[:4]
    segreto = base64.b16encode(os.urandom(16)).decode().lower()
    env = dict(os.environ, NYCTALUS_CHAT_TOKEN=segreto)
    log = lambda n: open(d / (n + ".log"), "ab")     # noqa: E731
    p = subprocess.Popen([b, "chat", "--data", str(d), "--backend", "127.0.0.1:%d" % backend,
                          "--control", "127.0.0.1:%d" % controllo, "--socks", "127.0.0.1:%d" % socks,
                          "--max-file", "1"], stdout=subprocess.PIPE, stderr=log("chat"), env=env,
                         text=True, start_new_session=True)
    proc.append(p)
    indirizzo = None
    for riga in p.stdout:
        m = re.search(r"[a-z2-7]{56}\.nyct", riga)
        if m:
            indirizzo = m.group(0)
            break
    if not indirizzo:
        esci("la rubrica non parte (vedi %s)" % (d / "chat.log"))
    (d / "indirizzo").write_text(indirizzo + "\n")
    proc.append(subprocess.Popen([b, "start", "--directory", str(rete.f_elenco), "--authority", autorita_pub,
                                  "--socks", "127.0.0.1:%d" % socks, "--control", "127.0.0.1:%d" % monitor] + opz_prot(prot),
                                 stdout=log("rete"), stderr=subprocess.STDOUT, start_new_session=True))
    proc.append(subprocess.Popen([b, "site", "--backend", "127.0.0.1:%d" % backend, "--identity", str(d / "identita"),
                                  "--directory", str(rete.f_elenco), "--authority", autorita_pub, "--hops", "3"]
                                 + opz_prot(prot, rumore=False),
                                 stdout=log("servizio"), stderr=subprocess.STDOUT, start_new_session=True))
    # la casella cifrata: servizio di deposito con un SUO indirizzo .nyct (chi deposita arriva
    # dai circuiti senza presentarsi; la posta la ritira il destinatario dalla rubrica)
    casella = PORTE_RUBRICA[4] if len(PORTE_RUBRICA) > 4 else PORTE_RUBRICA[0] + 4
    proc.append(subprocess.Popen([sys.executable, str(Path(__file__).resolve().parent / "rubrica.py"), str(d),
                                  str(controllo), str(casella)], stdout=log("rubrica"), stderr=subprocess.STDOUT,
                                 env=env, start_new_session=True))
    f_cas = d / "casella.log"
    f_cas.write_bytes(b"")
    proc.append(subprocess.Popen([b, "site", "--backend", "127.0.0.1:%d" % casella, "--identity",
                                  str(d / "casella-identita"), "--directory", str(rete.f_elenco),
                                  "--authority", autorita_pub, "--hops", "3"] + opz_prot(prot, rumore=False),
                                 stdout=open(f_cas, "ab"), stderr=subprocess.STDOUT, start_new_session=True))
    for _ in range(240):                                  # finché il servizio non è in rete
        m = re.search(r"[a-z2-7]{56}\.nyct", f_cas.read_text(errors="replace"))
        if m:
            (d / "casella-indirizzo").write_text(m.group(0) + "\n")
            break
        time.sleep(0.25)
    else:
        print("! la casella cifrata non è partita (vedi %s): la rete funziona lo stesso, senza casella" % f_cas)
    return indirizzo


def importa(argomento):
    cfg = {}
    if CONFIG_CLIENT.exists():
        try:
            cfg = json.loads(CONFIG_CLIENT.read_text())
        except Exception:     # noqa: BLE001
            cfg = {}
    if argomento == "--prova":
        for k in ("directory_url", "authority", "nome_rete", "rubrica", "casella", "camuffamento", "rumore"):
            cfg.pop(k, None)
        msg = "questo PC torna alla rete di prova locale"
    else:
        testo = argomento
        if not argomento.strip().startswith(PREFISSO):      # un file che contiene il codice
            try:
                testo = Path(argomento).read_text()
            except OSError:
                pass
        try:
            rete = leggi_codice(testo)
        except ValueError as e:
            esci(str(e))
        cfg.update({"directory_url": rete["directory_url"], "authority": rete["authority"], "nome_rete": rete["nome"]})
        for k in ("rubrica", "casella", "camuffamento", "rumore"):   # se la rete li ha
            cfg.pop(k, None)
            if rete.get(k):
                cfg[k] = rete[k]
        reti = [r for r in reti_salvate(cfg) if not (r["authority"] == rete["authority"]
                                                    and r["directory_url"] == rete["directory_url"])]
        cfg["reti"] = (reti + [rete])[-20:]
        msg = "questo PC ora usa la rete «%s» (impronta %s)" % (rete["nome"], impronta(rete["authority"]))
    CONFIG_CLIENT.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_CLIENT.write_text(json.dumps(cfg, indent=1) + "\n")
    ok(msg)
    print("  Chiudi e riapri chat e browser perché la usino.")


def leggi_config_client():
    try:
        return json.loads(CONFIG_CLIENT.read_text())
    except Exception:         # noqa: BLE001
        return {}


def reti_salvate(cfg):
    """Le reti importate su questo PC (come sul telefono): si passa dall'una all'altra."""
    reti = [r for r in cfg.get("reti", []) if isinstance(r, dict) and r.get("directory_url") and r.get("authority")]
    if cfg.get("directory_url") and cfg.get("authority") and not any(
            r["authority"] == cfg["authority"] and r["directory_url"] == cfg["directory_url"] for r in reti):
        reti.append({"nome": cfg.get("nome_rete") or "Rete Nyctalus", "directory_url": cfg["directory_url"],
                     "authority": cfg["authority"]})
    return reti


def elenca_reti():
    cfg = leggi_config_client()
    reti = reti_salvate(cfg)
    if not reti:
        print("Nessuna rete salvata: questo PC usa la rete di prova. Per collegarti: nyctalus-rete importa CODICE")
        return
    for i, r in enumerate(reti):
        attiva = r["authority"] == cfg.get("authority") and r["directory_url"] == cfg.get("directory_url")
        print("  %s %d  %s · %s%s" % ("●" if attiva else "○", i, r["nome"], impronta(r["authority"]), "  (in uso)" if attiva else ""))
    print("  Passa a un'altra:  nyctalus-rete usa N    ·  rete di prova:  nyctalus-rete importa --prova")


def usa_rete(n):
    cfg = leggi_config_client()
    reti = reti_salvate(cfg)
    if not 0 <= n < len(reti):
        esci("rete %d non trovata (nyctalus-rete reti per l'elenco)" % n)
    r = reti[n]
    cfg.update({"directory_url": r["directory_url"], "authority": r["authority"], "nome_rete": r["nome"], "reti": reti})
    for k in ("rubrica", "casella"):          # rubrica e casella della rete (se ci sono)
        cfg.pop(k, None)
        if r.get(k):
            cfg[k] = r[k]
    CONFIG_CLIENT.write_text(json.dumps(cfg, indent=1) + "\n")
    ok("questo PC ora usa la rete «%s» (impronta %s)" % (r["nome"], impronta(r["authority"])))
    print("  Chiudi e riapri chat e browser perché la usino.")


